{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "web-app7",
  "main": "worker.js",
  "compatibility_date": "2026-07-30",
  "compatibility_flags": ["nodejs_compat"],
  "d1_databases": [
    { "binding": "DB","database_id": "80b7c961-eee2-406a-a5ac-a0fe241d738a","database_name": "web-app787" }
  ],
  "kv_namespaces": [
    { "binding": "KV","id": "f850b90b886c4089828699a5489f4a73" }
  ],
  "workers_dev": true,
  "preview_urls": true,
  "observability": {
    "enabled": true,
    "logs": {
      "enabled": true,
      "head_sampling_rate": 1,
      "invocation_logs": true
    },
    "traces": {
      "enabled": true,
      "head_sampling_rate": 0.01
    }
  }
}
